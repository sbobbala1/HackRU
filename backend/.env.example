# Path to a Firebase service-account JSON file. Do not commit it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Optional, defaults to the Firebase project from service-account credentials.
FIREBASE_PROJECT_ID=
# Optional. Enables structured criterion parsing suggestions and plain-language summaries.
# Criterion states always come from the deterministic rules engine.
OPENAI_API_KEY=
OPENAI_MATCHING_MODEL=gpt-4o-mini
# Optional plain-language public trial explainer model. Falls back to source excerpts without a key.
OPENAI_EXPLAINER_MODEL=gpt-4o-mini
# Gemini is preferred when this key is configured. OpenAI remains an optional fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
