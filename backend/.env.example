# Path to a Firebase service-account JSON file. Do not commit it.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Optional, defaults to the Firebase project from service-account credentials.
FIREBASE_PROJECT_ID=
# Optional. Enables structured criterion parsing suggestions and plain-language summaries.
# Criterion states always come from the deterministic rules engine.
OPENAI_API_KEY=
OPENAI_MATCHING_MODEL=gpt-4o-mini
