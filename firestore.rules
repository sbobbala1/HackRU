rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /patientProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /trials/{trialId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null &&
        request.auth.token.role == 'researcher';
    }
    match /savedTrials/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.patientId;
    }
    // Match results and invitations are deliberately server-only. FastAPI uses
    // Firebase Admin credentials and enforces consent before returning them.
    match /matchResults/{documentId} { allow read, write: if false; }
    match /invitations/{documentId} { allow read, write: if false; }
  }
}
